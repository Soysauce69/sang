PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Connection Strings
# 1. DATABASE_URL: Transaction pooler (Port 6543) used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct session connection (Port 5432) used for Prisma migrations & schema pushes
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Auth Token generation
JWT_SECRET="rideshare_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"
